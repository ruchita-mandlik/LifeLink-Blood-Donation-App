<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".LifeLinkApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifeLink"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">

        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.LifeLink.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".activities.LoginActivity" android:exported="false" />
        <activity android:name=".activities.RegisterActivity" android:exported="false" />
        <activity android:name=".activities.DashboardActivity" android:exported="false" />
        <activity android:name=".activities.RegisterDonorActivity" android:exported="false" />
        <activity android:name=".activities.SearchDonorActivity" android:exported="false" />
        <activity android:name=".activities.DonorDetailsActivity" android:exported="false" />
        <activity android:name=".activities.BloodRequestActivity" android:exported="false" />
        <activity android:name=".activities.DonationHistoryActivity" android:exported="false" />
        <activity android:name=".activities.ProfileActivity" android:exported="false" />
        <activity android:name=".activities.EditProfileActivity" android:exported="false" />
        <activity android:name=".activities.AboutActivity" android:exported="false" />
        <activity android:name=".activities.SettingsActivity" android:exported="false" />

    </application>

</manifest>
