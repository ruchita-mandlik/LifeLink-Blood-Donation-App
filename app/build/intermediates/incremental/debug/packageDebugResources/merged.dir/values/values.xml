    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/divider</item>
    </style>
    <style name="TextAppearance.LifeLink" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.LifeLink.Body" parent="TextAppearance.LifeLink">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="TextAppearance.LifeLink.Headline" parent="TextAppearance.LifeLink">
        <item name="android:textSize">@dimen/text_size_headline</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.LifeLink.Title" parent="TextAppearance.LifeLink">
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.LifeLink.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Theme.LifeLink" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/red_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/red_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/red_primary_dark</item>
        <item name="android:navigationBarColor">?android:attr/windowBackground</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="textInputStyle">@style/Widget.LifeLink.TextInputLayout</item>
    </style>
    <style name="Theme.LifeLink.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    <style name="Theme.LifeLink.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/gradient_splash_background</item>
        <item name="android:statusBarColor">@color/red_primary_dark</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="Theme.LifeLink.Toolbar" parent="ThemeOverlay.Material3.Dark.ActionBar"/>
    <style name="Widget.LifeLink.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/corner_radius_md</item>
        <item name="backgroundTint">@color/red_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="rippleColor">@color/red_primary_light</item>
    </style>
    <style name="Widget.LifeLink.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/corner_radius_md</item>
        <item name="strokeColor">@color/red_primary</item>
        <item name="android:textColor">@color/red_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.LifeLink.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/corner_radius_md</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="rippleColor">@color/ripple</item>
    </style>
    <style name="Widget.LifeLink.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/corner_radius_sm</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_radius_sm</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_radius_sm</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_radius_sm</item>
        <item name="boxStrokeColor">@color/red_primary</item>
        <item name="hintTextColor">@color/red_primary</item>
    </style>
</resources>